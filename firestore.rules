                 && (roleIs("admin") || leadsTeamRole("tech") || hasDashboardAccess("technicalMaterialsManage"))
               && request.resource.data.technicalMaterialId is string
               && exists(/databases/$(database)/documents/technicalMaterials/$(request.resource.data.technicalMaterialId))
                && (get(/databases/$(database)/documents/technicalMaterials/$(request.resource.data.technicalMaterialId)).data.get("createdByUid", "") == request.auth.uid
                  || get(/databases/$(database)/documents/technicalMaterials/$(request.resource.data.technicalMaterialId)).data.get("updatedByUid", "") == request.auth.uid)
               && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("active", false) == true
                && (get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("role", "") == "tech"
                   || get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("teamLeadRoles", []).hasAny(["tech"])
                   || (get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("role", "") == "admin"
                     && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("adminTeamAssignment", "") in ["member:tech", "leader:tech"])
                  || (request.resource.data.technicalAccessGrantId is string
                    && technicalAccessGrantMatchesMember(request.resource.data.technicalAccessGrantId, uid))))
          );
        allow delete: if false;
      }
    }

    match /leaderChats/{chatId} {
      allow read: if chatParticipant(resource.data);
      allow create: if member()
        && request.resource.data.keys().hasAll([
          "memberUid", "memberName", "leaderUid", "leaderName", "universityTag",
          "universityName", "lastMessagePreview", "lastSenderUid", "lastMessageAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "memberUid", "memberName", "leaderUid", "leaderName", "universityTag",
          "universityName", "lastMessagePreview", "lastSenderUid", "lastMessageAt",
          "updatedAt"
        ])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.memberName is string
        && request.resource.data.leaderName is string
        && request.resource.data.universityTag is string
        && validUniversityTag(request.resource.data.universityTag)
        && request.resource.data.universityTag != ""
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() >= 1
        && request.resource.data.lastMessagePreview.size() <= 160
        && validChatParticipant(request.resource.data);
      allow update: if chatParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessagePreview", "lastSenderUid", "lastMessageAt", "updatedAt"
        ])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() >= 1
        && request.resource.data.lastMessagePreview.size() <= 160
        && validChatParticipant(request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatParticipant(get(/databases/$(database)/documents/leaderChats/$(chatId)).data);
        allow create: if chatParticipant(get(/databases/$(database)/documents/leaderChats/$(chatId)).data)
          && request.resource.data.keys().hasAll(["text", "senderUid", "senderName", "createdAt"])
          && request.resource.data.keys().hasOnly(["text", "senderUid", "senderName", "createdAt"])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
