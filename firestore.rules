        && validTaskAssets(request.resource.data)
        && validTaskGame(request.resource.data)
        && validTaskCover(request.resource.data)
        && validTaskCreatorDisplay(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 8
        && request.resource.data.description.size() <= 1200
        && validTaskRole(request.resource.data.targetRole)
        && validTaskMode(request.resource.data.mode)
        && request.resource.data.xp is int
        && request.resource.data.xp >= 1
        && request.resource.data.xp <= 100000
        && request.resource.data.status == "open"
        && request.resource.data.submissionCount == 0
        && request.resource.data.claimedByUid == ""
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "targetUniversityTag", "assignedMemberUids", "audienceMode"
          ])
          && canMigrateLegacyTaskAudience()
        ) || (
          canManageTask(resource.data)
          && validTaskCreatorScope(request.resource.data)
          && validTaskAudience(request.resource.data)
          && (hasDashboardAccess("tasksManage") || request.resource.data.targetRole == resource.data.targetRole)
          && ((request.resource.data.targetRole == resource.data.targetRole
              && request.resource.data.targetUniversityTag == resource.data.get("targetUniversityTag", "")
              && request.resource.data.assignedMemberUids == resource.data.get("assignedMemberUids", [])
              && request.resource.data.audienceMode == resource.data.get("audienceMode", "all")
              && request.resource.data.mode == resource.data.mode)
            || (hasDashboardAccess("tasksManage")
              && resource.data.get("submissionCount", 0) == 0
              && resource.data.status == "open"
              && resource.data.get("claimedByUid", "") == ""))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "description", "targetRole", "targetUniversityTag",
            "assignedMemberUids", "audienceMode", "mode", "xp", "status", "claimedByUid", "updatedAt",
            "assets", "gameType", "gameUrl", "gameHtml", "dueAt",
            "imageUrl", "coverDriveFileId", "coverDriveFileName", "coverDriveMimeType",
            "coverDriveSizeBytes", "coverDriveUploadedByUid", "coverDriveUploadedAt"
          ])
          && validTaskDeadline(request.resource.data)
          && validTaskAssets(request.resource.data)
          && validTaskGame(request.resource.data)
          && validTaskCover(request.resource.data)
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 8
          && request.resource.data.description.size() <= 1200
          && validTaskRole(request.resource.data.targetRole)
          && validTaskMode(request.resource.data.mode)
          && request.resource.data.xp is int
          && request.resource.data.xp >= 1
          && request.resource.data.xp <= 100000
          && (request.resource.data.status == "open" || request.resource.data.status == "closed" || request.resource.data.status == "claimed")
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
        ) || (
          canSubmitTask(resource.data)
          && resource.data.status == "open"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "submissionCount", "claimedByUid", "status", "updatedAt"
          ])
          && request.resource.data.submissionCount == resource.data.submissionCount + 1
           && getAfter(/databases/$(database)/documents/tasks/$(taskId)/submissions/$(request.auth.uid)).data.submitterUid == request.auth.uid
           && getAfter(/databases/$(database)/documents/tasks/$(taskId)/submissions/$(request.auth.uid)).data.status == "pending"
           && getAfter(/databases/$(database)/documents/tasks/$(taskId)/submissions/$(request.auth.uid)).data.xpAwarded == 0
           && request.resource.data.claimedByUid == resource.data.claimedByUid
           && request.resource.data.status == resource.data.status
        );
      allow delete: if canManageTask(resource.data);

      match /submissions/{uid} {
        allow read: if roleIs("admin")
          || canManageTask(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          || (member() && uid == request.auth.uid && canSubmitTask(get(/databases/$(database)/documents/tasks/$(taskId)).data));
        allow create: if member()
          && uid == request.auth.uid
          && canSubmitTask(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.status == "open"
          && request.resource.data.keys().hasAll([
            "taskId", "submitterUid", "submitterName", "teamRole", "text",
            "link", "links", "xpAwarded", "status", "submittedAt"
          ])
          && request.resource.data.keys().hasOnly([
            "taskId", "submitterUid", "submitterName", "teamRole", "text",
            "link", "links", "xpAwarded", "status", "submittedAt", "gameResult"
          ])
          && validGameResult(request.resource.data)
          && request.resource.data.taskId == taskId
          && request.resource.data.submitterUid == request.auth.uid
          && request.resource.data.teamRole == get(/databases/$(database)/documents/tasks/$(taskId)).data.targetRole
          && request.resource.data.submitterName is string
          && request.resource.data.submitterName.size() >= 1
          && request.resource.data.submitterName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 3000
          && request.resource.data.link is string
          && request.resource.data.link.size() <= 1000
          && (request.resource.data.link == "" || request.resource.data.link.matches("^https?://.+"))
          && validLinkEntries(request.resource.data)
           && request.resource.data.xpAwarded == 0
           && request.resource.data.status == "pending";
        allow update: if canManageTask(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          && (roleIs("admin") || uid != request.auth.uid)
          && resource.data.taskId == taskId
          && resource.data.submitterUid == uid
          && resource.data.get("status", "pending") == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "xpAwarded", "reviewedByUid", "reviewedAt"
          ])
          && request.resource.data.status in ["approved", "rejected"]
          && request.resource.data.xpAwarded is int
          && request.resource.data.xpAwarded >= 0
          && request.resource.data.xpAwarded <= get(/databases/$(database)/documents/tasks/$(taskId)).data.get("xp", 0)
          && (request.resource.data.status != "rejected" || request.resource.data.xpAwarded == 0)
          && request.resource.data.reviewedByUid == request.auth.uid
          && request.resource.data.reviewedAt == request.time;
        allow delete: if canManageTask(get(/databases/$(database)/documents/tasks/$(taskId)).data);
      }
    }

    match /memberRatings/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
          || roleIs("admin")
          || hasDashboardAccess("ratingsRead")
          || (roleIs("leaders")
            && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("active", false) == true
            && get(/databases/$(database)/documents/teamMembers/$(uid)).data.role != "admin"
            && validUniversityTag(get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("universityTag", ""))
            && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("universityTag", "") != ""
            && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("universityTag", "")
              == get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.get("leadingUniversityTag", ""))
          || (exists(/databases/$(database)/documents/teamMembers/$(uid))
            && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("active", false) == true
            && get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("role", "") != "admin"
            && leadsTeamRole(get(/databases/$(database)/documents/teamMembers/$(uid)).data.get("role", ""))));
      allow create, update: if (canRateMember(uid)
          || (canResetMember(uid, "ratingsReset")
            && request.resource.data.scores == {} && request.resource.data.notes == {}))
        && request.resource.data.keys().hasAll(["scores", "notes", "universityTag", "active", "updatedByUid", "updatedAt"])
        && request.resource.data.keys().hasOnly(["scores", "notes", "universityTag", "active", "updatedByUid", "updatedAt"])
        && validRatingScores(request.resource.data.scores)
        && validRatingNotes(request.resource.data.notes)
        && request.resource.data.universityTag
          == getAfter(/databases/$(database)/documents/teamMembers/$(uid)).data.get("universityTag", "")
        && request.resource.data.active == getAfter(/databases/$(database)/documents/teamMembers/$(uid)).data.get("active", false)
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /teamMembers/{uid} {
