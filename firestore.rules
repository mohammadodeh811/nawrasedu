          "submissionCount", "claimedByUid", "createdBy", "createdAt", "updatedAt",
          "assets", "gameType", "gameUrl", "gameHtml", "dueAt",
          "imageUrl", "coverDriveFileId", "coverDriveFileName", "coverDriveMimeType",
          "coverDriveSizeBytes", "coverDriveUploadedByUid", "coverDriveUploadedAt",
