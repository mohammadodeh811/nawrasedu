      // private contact details, or other sensitive data in this document.
      allow read: if (signedIn() && request.auth.uid == uid)
        || resource.data.active == true
        || roleIs("admin");
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/deletedAccounts/$(uid))
        && request.resource.data.keys().hasAll([
          "uid", "displayName", "photoURL", "bio", "socialLinks", "role", "active",
          "dashboardRoles", "universityTag", "leadingUniversityTag", "xp", "level",
          "answersCount", "tasksCompleted", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "photoURL", "bio", "socialLinks", "role", "active",
          "dashboardRoles", "universityTag", "leadingUniversityTag", "xp", "level",
          "photoDriveFileId", "photoFileName", "photoMimeType", "photoSizeBytes", "photoUploadedByUid", "photoUploadedAt",
          "answersCount", "tasksCompleted", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL == ""
        && request.resource.data.bio == ""
        && validSocialLinks(request.resource.data.socialLinks)
        && request.resource.data.role == "user"
        && request.resource.data.active == true
        && request.resource.data.dashboardRoles is list
        && request.resource.data.dashboardRoles.size() == 1
        && request.resource.data.dashboardRoles.hasOnly(["user"])
        && request.resource.data.universityTag == ""
        && request.resource.data.leadingUniversityTag == ""
        && request.resource.data.xp == 0
        && request.resource.data.level == 1
        && request.resource.data.answersCount == 0
        && request.resource.data.tasksCompleted == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          roleIs("admin")
          && (request.resource.data.role == resource.data.role
            || (uid != request.auth.uid
              && resource.data.role != "admin"
              && request.resource.data.role in ["user", "leaders", "public", "tech", "social", "designers", "content", "event"]))
          && request.resource.data.active == resource.data.active
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "photoURL", "bio", "xp", "level", "answersCount", "updatedAt", "lastTaskId", "lastAnsweredQuestionId", "tasksCompleted", "universityTag", "leadingUniversityTag", "role", "dashboardRoles", "teamLeadRoles", "adminTeamAssignment"
          ])
          && (!request.resource.data.keys().hasAny(["dashboardRoles"])
            || (request.resource.data.dashboardRoles is list
              && request.resource.data.dashboardRoles.size() <= 8
              && request.resource.data.dashboardRoles.hasOnly(["user", "leaders", "public", "tech", "social", "designers", "content", "event"])
              && (request.resource.data.role == "user"
                || request.resource.data.dashboardRoles.size() == 0)))
          && (!request.resource.data.keys().hasAny(["teamLeadRoles"])
            || (request.resource.data.teamLeadRoles is list
              && request.resource.data.teamLeadRoles.size() <= 8
              && request.resource.data.teamLeadRoles.hasOnly(["user", "leaders", "public", "tech", "social", "designers", "content", "event"])))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["xp"])
            || (request.resource.data.xp is int
              && request.resource.data.xp >= 0
              && request.resource.data.xp <= 100000000
              && request.resource.data.level is int
              && request.resource.data.level >= 1))
